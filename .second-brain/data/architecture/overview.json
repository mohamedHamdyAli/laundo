    "runtime": {
        "rate_limiters": [
            "api",
            "otp",
            "otp-verify",
            "location",
            "tracking",
            "login"
        ],
        "schedule": [
            {
                "command": "orders:prompt-recurring",
                "cadence": "dailyAt('09:00')"
            },
            {
                "command": "tasks:dispatch",
                "cadence": "everyTenMinutes()"
            },
            {
                "command": "tasks:alert-stuck",
                "cadence": "hourly()"
            },
            {
                "command": "laundo:prune",
                "cadence": "weeklyOn(0, '03:30')"
            },
            {
                "command": "orders:alert-silent-confirmations",
                "cadence": "hourly()"
            },
            {
                "command": "laundo:weekly-reports",
                "cadence": "weeklyOn(0, '08:00')"
            },
            {
                "command": "drivers:close-bonus-month",
                "cadence": "monthlyOn(1, '07:00')"
            },
            {
                "command": "loyalty:expire-points",
                "cadence": "dailyAt('10:00')"
            }
        ]
    },
