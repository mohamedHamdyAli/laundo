includes:
    # larastan moved from nunomaduro/ to larastan/ at v3; the old path made
    # `composer stan` fail before it analysed anything.
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
    excludePaths:
        analyseAndScan:
            - app/Console/Kernel.php (?)
            - app/Exceptions/Handler.php (?)
